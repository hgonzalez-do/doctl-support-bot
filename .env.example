# --- Required ---------------------------------------------------------------
# Endpoint of the Gradient AI agent that owns the knowledge base (its `deployment.url`).
# The agent retrieves and generates; this app just forwards the conversation.
AGENT_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxx.agents.do-ai.run

# That agent's endpoint access key. Scoped to this one agent — it is NOT a DigitalOcean API
# token and cannot be used against https://api.digitalocean.com.
AGENT_ACCESS_KEY=replace_me

# --- Optional ---------------------------------------------------------------
# Passed through as the `model` field on endpoint requests. The agent's own configured
# foundation model is what actually answers.
AGENT_MODEL=llama-4-maverick
AGENT_MAX_TOKENS=800
# Optional: serve the release index live from GitHub instead of the deploy-time copy.
# Powers the header badge only; answers never read it.
RELEASE_INDEX_URL=https://raw.githubusercontent.com/hgonzalez-do/doctl-support-bot/main/docs/release-index.json
PORT=8080
